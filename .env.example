# Copiá este archivo como .env y completá los valores. El archivo .env NUNCA se sube a GitHub.

# Puerto local (Heroku lo define solo)
PORT=3000

# Clave para firmar las sesiones. Poné un texto largo y aleatorio.
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# true = muestra los usuarios de prueba en la pantalla de ingreso
MODO_DEMO=true

# Contraseña de los usuarios de prueba (se aplica al generar los datos con npm run seed)
CLAVE_DEMO=relampago2026

# Dirección pública del sitio, para el QR de la cantina (ej.: https://club-relampago.herokuapp.com)
URL_SITIO=

# MongoDB (todavía no activo). Cuando lo actives: USAR_MONGO=true y la cadena de conexión.
USAR_MONGO=false
MONGO_URI=
