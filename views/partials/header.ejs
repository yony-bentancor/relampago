<header class="main-header"> <%- include('../partials/head') %>

  <div class="header-container">

    <a href="/" class="brand">

      <img
        src="/img/logo-relampago.png"
        alt="Club Atlético Relámpago"
        class="brand-logo"
      >

      <div class="brand-text">

        <span class="brand-title">
          Club Atlético Relámpago
        </span>

        <span class="brand-subtitle">
          Baby Fútbol
        </span>

      </div>

    </a>

    <nav class="main-nav">

      <a href="/">
        <i class="fa-solid fa-house"></i>
        <span>Inicio</span>
      </a>

      <a href="/categorias">
        <i class="fa-solid fa-trophy"></i>
        <span>Categorías</span>
      </a>

      <a href="/fixture">
        <i class="fa-solid fa-calendar-days"></i>
        <span>Fixture</span>
      </a>

      <a href="/noticias">
        <i class="fa-solid fa-newspaper"></i>
        <span>Noticias</span>
      </a>

      <a href="/sponsors">
        <i class="fa-solid fa-handshake"></i>
        <span>Sponsors</span>
      </a>

    </nav>

    <div class="header-actions">

      <a href="/inscripcion" class="btn-socio">
        <i class="fa-solid fa-user-plus"></i>
        Hacete socio
      </a>

      <a href="/auth/login" class="btn-login">
        <i class="fa-solid fa-right-to-bracket"></i>
        Iniciar sesión
      </a>

    </div>

  </div>

</header>