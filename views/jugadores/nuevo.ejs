<%- include('../partials/header') %>

<section class="form-page">

  <div class="form-container">

    <div class="form-header">
      <h1>Nuevo Jugador</h1>
      <p>Registrar nuevo niño en el club.</p>
    </div>

    <form action="/jugadores/nuevo" method="POST" enctype="multipart/form-data">

      <div class="form-grid">

        <div class="form-group">
          <label>Nombre</label>
          <input type="text" name="nombre" required>
        </div>

        <div class="form-group">
          <label>Apellido</label>
          <input type="text" name="apellido" required>
        </div>

        <div class="form-group">
          <label>Fecha nacimiento</label>
          <input type="date" name="fechaNacimiento">
        </div>

        <div class="form-group">
          <label>Categoría</label>

          <select name="categoria">
            <option value="">Seleccionar</option>

            <% categorias.forEach(cat => { %>
              <option value="<%= cat._id %>">
                <%= cat.nombre %>
              </option>
            <% }) %>

          </select>
        </div>

        <div class="form-group">
          <label>Ficha médica</label>
          <input type="text" name="fichaMedica">
        </div>

        <div class="form-group">
          <label>Mutualista</label>
          <input type="text" name="mutualista">
        </div>

        <div class="form-group full">
          <label>Observaciones médicas</label>
          <textarea name="observaciones"></textarea>
        </div>

        <div class="form-group full">
          <label>Foto</label>
          <input type="file" name="foto">
        </div>

      </div>

      <div class="form-actions">
        <button type="submit" class="btn-save">
          Guardar jugador
        </button>
      </div>

    </form>

  </div>

</section>

<%- include('../partials/footer') %>