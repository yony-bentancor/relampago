<%- include('../partials/header') %>

<section class="form-page">

  <div class="form-container">

    <div class="form-header">
      <h1>Editar Jugador</h1>
      <p>Modificar información del jugador.</p>
    </div>

    <form action="/jugadores/<%= jugador._id %>/editar" method="POST" enctype="multipart/form-data">

      <div class="form-grid">

        <div class="form-group">
          <label>Nombre</label>
          <input
            type="text"
            name="nombre"
            value="<%= jugador.nombre %>"
            required
          >
        </div>

        <div class="form-group">
          <label>Apellido</label>
          <input
            type="text"
            name="apellido"
            value="<%= jugador.apellido %>"
            required
          >
        </div>

        <div class="form-group">
          <label>Fecha nacimiento</label>
          <input
            type="date"
            name="fechaNacimiento"
            value="<%= jugador.fechaNacimiento ? jugador.fechaNacimiento.toISOString().split('T')[0] : '' %>"
          >
        </div>

        <div class="form-group">
          <label>Categoría</label>

          <select name="categoria">

            <% categorias.forEach(cat => { %>

              <option
                value="<%= cat._id %>"
                <%= jugador.categoria && jugador.categoria.toString() === cat._id.toString()
                  ? 'selected'
                  : '' %>
              >
                <%= cat.nombre %>
              </option>

            <% }) %>

          </select>
        </div>

        <div class="form-group">
          <label>Ficha médica</label>
          <input
            type="text"
            name="fichaMedica"
            value="<%= jugador.fichaMedica || '' %>"
          >
        </div>

        <div class="form-group">
          <label>Mutualista</label>
          <input
            type="text"
            name="mutualista"
            value="<%= jugador.mutualista || '' %>"
          >
        </div>

        <div class="form-group full">
          <label>Observaciones</label>
          <textarea name="observaciones"><%= jugador.observaciones || '' %></textarea>
        </div>

        <div class="form-group full">

          <label>Nueva foto</label>

          <% if (jugador.foto) { %>
            <img
              src="<%= jugador.foto %>"
              class="preview-foto"
            >
          <% } %>

          <input type="file" name="foto">
        </div>

      </div>

      <div class="form-actions">
        <button type="submit" class="btn-save">
          Guardar cambios
        </button>
      </div>

    </form>

  </div>

</section>

<%- include('../partials/footer') %>