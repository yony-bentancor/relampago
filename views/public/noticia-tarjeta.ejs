<article class="card" style="display:grid;grid-template-columns:<%= n.foto && compacta ? 'minmax(0,110px) minmax(0,1fr)' : 'minmax(0,1fr)' %>;gap:14px;align-items:start">
  <% if (n.foto) { %><img src="<%= n.foto %>" alt="" style="width:100%;<%= compacta ? 'aspect-ratio:1;' : 'aspect-ratio:16/8;' %>object-fit:cover;border-radius:8px"><% } %>
  <div style="min-width:0"><div class="eyebrow"><%= n.seccion %> · <%= fCorta(n.fecha) %></div><h3 style="margin-top:4px"><a href="/noticias/<%= n.id %>" style="color:inherit;text-decoration:none"><%= n.titulo %></a></h3>
  <p class="<%= compacta ? 'small ' : '' %>muted" style="margin-top:6px"><%= compacta && n.texto.length > 140 ? n.texto.slice(0, 140) + '…' : n.texto %></p></div>
</article>
